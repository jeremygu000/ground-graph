# =============================================================================
# Agentic GraphRAG - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets.
# =============================================================================

# Application
APP_ENV=development
APP_NAME=agentic-graphrag
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphrag
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# MinIO / S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me-local-only
S3_SECRET_KEY=change-me-local-only
S3_BUCKET_RAW=graphrag-raw
S3_BUCKET_PROCESSED=graphrag-processed
S3_REGION=us-east-1
S3_USE_SSL=false

# OpenAI / Model Provider
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GENERATION_MODEL=gpt-4o-mini
EXTRACTION_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# Phoenix / OpenTelemetry
OTEL_SERVICE_NAME=agentic-graphrag
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=agentic-graphrag

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
PROMETHEUS_PORT=9464

# Retrieval budgets
VECTOR_TOP_K=30
VECTOR_RERANKED_K=10
KEYWORD_TOP_K=20
GRAPH_DEPTH_DEFAULT=2
GRAPH_DEPTH_MAX=3
GRAPH_CANDIDATE_PATHS=20
FINAL_EVIDENCE_LIMIT=12
RETRIEVAL_RETRIES=1

# Telemetry policy
TELEMETRY_CAPTURE_CONTENT=false
TELEMETRY_SAMPLE_RATE=1.0
TELEMETRY_REDACT_PATTERNS=password,token,secret,api_key,authorization

# Authorization (development defaults — replace in production)
AUTH_MODE=local
AUTH_DEFAULT_PRINCIPAL=engineering
AUTH_DEFAULT_TENANT=default
AUTH_TRUSTED_HEADERS=false

# Index / ontology versioning
ONTOLOGY_VERSION=v0.1.0
INDEX_VERSION=v0.1.0
PROMPT_BUNDLE_VERSION=v0.1.0
