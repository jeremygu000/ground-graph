# =============================================================================
# groundgraph - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets.
# =============================================================================

# Application
APP_ENV=development
APP_NAME=groundgraph
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# API
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL + pgvector (application database)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=groundgraph
POSTGRES_USER=groundgraph
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Phoenix (separate database on the same instance, see docker-compose.yml)
PHOENIX_DB=phoenix

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# MinIO / S3
S3_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=change-me-local-only
S3_SECRET_KEY=change-me-local-only
S3_BUCKET_RAW=groundgraph-raw
S3_BUCKET_PROCESSED=groundgraph-processed
S3_REGION=us-east-1
S3_USE_SSL=false

# OpenAI / Model Provider
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GENERATION_MODEL=gpt-4o-mini
EXTRACTION_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# Phoenix / OpenTelemetry
OTEL_SERVICE_NAME=groundgraph
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_INSECURE=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=groundgraph
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
OTEL_INTERNAL_METRICS_PORT=8888
OTEL_APP_METRICS_PORT=8889
PHOENIX_PORT=6006
PHOENIX_PROMETHEUS_PORT=9091

# Prometheus
PROMETHEUS_PORT=9090

# Grafana (local compose admin)
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-local-only

# Retrieval budgets
VECTOR_TOP_K=30
VECTOR_RERANKED_K=10
KEYWORD_TOP_K=20
GRAPH_DEPTH_DEFAULT=2
GRAPH_DEPTH_MAX=3
GRAPH_CANDIDATE_PATHS=20
FINAL_EVIDENCE_LIMIT=12
RETRIEVAL_RETRIES=1

# Telemetry policy
TELEMETRY_CAPTURE_CONTENT=false
TELEMETRY_SAMPLE_RATE=1.0
TELEMETRY_REDACT_PATTERNS=password,token,secret,api_key,authorization

# Authorization (development defaults — replace in production)
AUTH_MODE=local
AUTH_DEFAULT_PRINCIPAL=engineering
AUTH_DEFAULT_TENANT=default
AUTH_TRUSTED_HEADERS=false

# Index / ontology versioning
ONTOLOGY_VERSION=v0.1.0
INDEX_VERSION=v0.1.0
PROMPT_BUNDLE_VERSION=v0.1.0
