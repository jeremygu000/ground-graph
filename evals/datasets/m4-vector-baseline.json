{
  "name": "m4-vector-baseline",
  "version": "0.1.0",
  "description": "Golden evaluation dataset for the M4 vector RAG baseline. Each case exercises a single factual claim backed by an immutable source chunk. The dataset is intentionally small (40 cases) to support fast feedback in CI while still covering positive, negative, ACL, refusal, temporal, and multi-entity scenarios.",
  "embedding_model": "text-embedding-3-small",
  "embedding_dimension": 1536,
  "reranker_model": "lexical-blend",
  "generator_model": "gpt-4o-mini",
  "cases": [
