# syntax=docker/dockerfile:1.4
# Multi-stage production Dockerfile for GroundGraph API.
# Build: docker build -f deploy/docker/Dockerfile.prod -t groundgraph/api:latest .
# Run:   docker run --env-file .env.prod groundgraph/api:latest

# ── Stage 1: Python build ────────────────────────────────────────────────────
FROM python:3.12-slim AS python_builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv && \
    uv sync --frozen --no-install-project --no-dev --all-extras

# ── Stage 2: Test / lint ────────────────────────────────────────────────────
FROM python_builder AS test
COPY . .
RUN uv sync --frozen --all-extras
RUN uv run ruff check src/
RUN uv run pyright src/

# ── Stage 3: Production image ──────────────────────────────────────────────
FROM python:3.12-slim AS production

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash appuser

COPY --from=python_builder /app/.venv /app/.venv
COPY --chown=appuser:appuser pyproject.toml uv.lock ./
COPY --chown=appuser:appuser src/groundgraph /app/src/groundgraph
COPY --chown=appuser:appuser apps/api /app/apps/api

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

# Run uvicorn with multiple workers for production use.
# Workers: 2×CPU + 1 (min 2, max 8). Bind to all interfaces.
ENTRYPOINT ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
