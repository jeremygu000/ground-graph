{
  "title": "groundgraph - Operations",
  "uid": "groundgraph-operations",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": ["groundgraph", "operations"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape targets up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=~\"$job\"}",
          "legendFormat": "{{instance}} ({{job}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OTel Collector - received spans/s (self-telemetry, :8888)",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "rate(otelcol_receiver_accepted_spans{job=\"otel-collector-internal\"}[1m])",
          "legendFormat": "{{receiver}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OTel Collector - refused spans/s (self-telemetry, :8888)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(otelcol_receiver_refused_spans{job=\"otel-collector-internal\"}[1m])",
          "legendFormat": "{{receiver}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Application metrics target (:8889)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "up{job=\"groundgraph-application\"}",
          "legendFormat": "application exporter up",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Phoenix self metrics (job: phoenix, :9090)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "up{job=\"phoenix\"}",
          "legendFormat": "phoenix up",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate (req/s) — groundgraph application",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "description": "Incoming request rate from groundgraph.http.requests counter. Requires app to be running for >= 60s for first data to appear (OTel export interval).",
      "targets": [
        {
          "expr": "sum(rate(groundgraph_http_requests_total{job=\"groundgraph-application\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx / total) — groundgraph application",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "description": "Proportion of requests returning 5xx status codes from groundgraph.http.request.errors counter. Requires app to be running for >= 60s for first data.",
      "targets": [
        {
          "expr": "sum(rate(groundgraph_http_request_errors_total{job=\"groundgraph-application\"}[5m])) / sum(rate(groundgraph_http_requests_total{job=\"groundgraph-application\"}[5m]))",
          "legendFormat": "5xx error rate",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (seconds) — groundgraph application",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "description": "Request latency quantiles from groundgraph.http.request.duration histogram. Requires app to be running for >= 60s. Uses histogram_quantile() with bucket aggregation.",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(groundgraph_http_request_duration_seconds_bucket{job=\"groundgraph-application\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(groundgraph_http_request_duration_seconds_bucket{job=\"groundgraph-application\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(groundgraph_http_request_duration_seconds_bucket{job=\"groundgraph-application\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    }
  ]
}
