{
  "title": "groundgraph - Operations",
  "uid": "groundgraph-operations",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": ["groundgraph", "operations"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape targets up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=~\"$job\"}",
          "legendFormat": "{{instance}} ({{job}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OTel Collector - received spans/s (self-telemetry, :8888)",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "rate(otelcol_receiver_accepted_spans{job=\"otel-collector-internal\"}[1m])",
          "legendFormat": "{{receiver}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OTel Collector - refused spans/s (self-telemetry, :8888)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(otelcol_receiver_refused_spans{job=\"otel-collector-internal\"}[1m])",
          "legendFormat": "{{receiver}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Application OTLP metrics (job: groundgraph-application, :8889)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rate(otelcol_exporter_sent_metric_points{job=\"otel-collector-internal\", exporter=\"prometheus\"}[1m])",
          "legendFormat": "sent metric points/s",
          "refId": "A"
        },
        {
          "expr": "rate(otelcol_exporter_send_failed_metric_points{job=\"otel-collector-internal\", exporter=\"prometheus\"}[1m])",
          "legendFormat": "send failed/s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Phoenix self metrics (job: phoenix, :9090)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "up{job=\"phoenix\"}",
          "legendFormat": "phoenix up",
          "refId": "A"
        }
      ]
    }
  ]
}
